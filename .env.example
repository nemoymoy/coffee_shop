# ============================================
# Coffee Shop — Переменные окружения
# ============================================
# Скопируйте этот файл в .env и заполните значения:
#   cp .env.example .env
# ============================================

# --------------------------------------------
# Django
# --------------------------------------------
SECRET_KEY=change-me-to-super-secret-key-at-least-50-chars
DEBUG=True
DOMAIN=localhost
ALLOWED_HOSTS=localhost,127.0.0.1

# --------------------------------------------
# Database (PostgreSQL)
# --------------------------------------------
DATABASE_URL=postgresql://coffee_shop:password@db:5432/coffee_shop
POSTGRES_DB=coffee_shop
POSTGRES_USER=coffee_shop
POSTGRES_PASSWORD=change-me-secure-password

# --------------------------------------------
# Redis (cache + Celery broker)
# --------------------------------------------
REDIS_PASSWORD=CHANGE_ME_SECURE_PASSWORD
REDIS_URL=redis://:${REDIS_PASSWORD}@redis:6379/0

# --------------------------------------------
# Email (RuSender SMTP)
# --------------------------------------------
# Production
RUSENDER_USERNAME=your-rusender-email@example.com
RUSENDER_PASSWORD=your-rusender-password
EMAIL_FROM=noreply@yourdomain.com
# Dev (console backend)
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend

# --------------------------------------------
# YooKassa (ЮКасса)
# --------------------------------------------
YOOKASSA_MERCHANT_ID=your-shop-id
YOOKASSA_API_KEY=your-secret-key
YOOKASSA_WEBHOOK_SECRET=your-webhook-secret
YOOKASSA_RETURN_URL=https://yourdomain.com/pay/callback/
YOOKASSA_TEST_MODE=true

# Legacy aliases (YooMoney) — backward compatibility
YOOMONEY_SHOP_ID=
YOOMONEY_SECRET_KEY_1=
YOOMONEY_SECRET_KEY_2=

# --------------------------------------------
# Yandex Delivery OAuth
# --------------------------------------------
YANDEX_DELIVERY_CLIENT_ID=your-client-id
YANDEX_DELIVERY_CLIENT_SECRET=your-client-secret
YANDEX_REDIRECT_URI=https://yourdomain.com/delivery/callback/

# --------------------------------------------
# Yandex Delivery from address
# --------------------------------------------
YANDEX_FROM_CITY=moscow
YANDEX_FROM_STREET=
YANDEX_FROM_HOUSE=
YANDEX_FROM_APT=

# --------------------------------------------
# Yandex Delivery Merchant API
# --------------------------------------------
# merchant_id автоматически получает через API при первом заказе
YANDEX_DELIVERY_MERCHANT_ID=
YANDEX_DELIVERY_GEO_ID=213

# --------------------------------------------
# Yandex Delivery (tokens + URLs)
# --------------------------------------------
YANDEX_DELIVERY_TOKEN=ya2_AgAAAA...
YANDEX_SHOP_LAT=53.216940239129094
YANDEX_SHOP_LON=50.162688008923745
YANDEX_SHOP_ADDRESS=Самара, ул. Революционная, д. 3

YANDEX_PVZ_ID=d0222b1e-73ff-4274-9c68-42c79d4c7eae
YANDEX_PVZ_LAT=53.200850
YANDEX_PVZ_LON=50.150500
YANDEX_PVZ_ADDRESS=г. Самара, ул. Лукачева, д. 6

YANDEX_EXPRESS_BASE_URL=https://b2b.taxi.yandex.net/b2b/cargo/integration/v2

# Test environment
YANDEX_DELIVERY_TEST_MODE=false
YANDEX_DELIVERY_TEST_TOKEN=
YANDEX_DELIVERY_TEST_BASE_URL=https://b2b.taxi.tst.yandex.net
YANDEX_DELIVERY_TEST_WAREHOUSE_ID=

# --------------------------------------------
# Yandex Metrika
# --------------------------------------------
YANDEX_METRIKA_ID=
YANDEX_METRIKA_WEBVIEWER=0

# --------------------------------------------
# Yandex Maps API
# --------------------------------------------
YANDEX_MAPS_API_KEY=

# --------------------------------------------
# Yandex OAuth 2.0 (авторизация пользователей)
# --------------------------------------------
YANDEX_OAUTH_CLIENT_ID=
YANDEX_OAUTH_CLIENT_SECRET=

# --------------------------------------------
# Celery
# --------------------------------------------
CELERY_BROKER_URL=redis://:${REDIS_PASSWORD}@redis:6379/0
CELERY_RESULT_BACKEND=django-db

# Celery Beat — интервалы периодических задач (в секундах)
CELERY_SYNC_YANDEX_INTERVAL=300          # Синхронизация Яндекс Доставки (5 мин)
CELERY_ACCEPT_EXPRESS_INTERVAL=120       # Автоприём Express заявок (2 мин)
CELERY_DAILY_REPORT_HOUR=9               # Ежедневный отчёт — час
CELERY_DAILY_REPORT_MINUTE=0             # Ежедневный отчёт — минута
CELERY_PROMO_CODES_INTERVAL=3600         # Проверка промокодов (1 час)
CELERY_RESERVATIONS_INTERVAL=3600        # Освобождение резервов (1 час)
