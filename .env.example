# ============================================================
# Coffee Shop — Environment Variables
# ============================================================
# Скопируйте этот файл в .env и заполните значения.
# НЕ коммитьте .env в git!
# ============================================================

# --- Django ---
SECRET_KEY=your-super-secret-key-at-least-50-chars-long
DEBUG=False
DOMAIN=localhost
ALLOWED_HOSTS=localhost,127.0.0.1

# --- PostgreSQL ---
POSTGRES_DB=coffee_shop
POSTGRES_USER=coffee_shop
POSTGRES_PASSWORD=your-secure-db-password-here
DATABASE_URL=postgresql://coffee_shop:your-secure-db-password-here@db:5432/coffee_shop

# --- Redis ---
REDIS_URL=redis://redis:6379/0

# --- Email (RuSender) ---
RUSENDER_USERNAME=your-rusender-email
RUSENDER_PASSWORD=your-rusender-password
EMAIL_FROM=noreply@yourdomain.com

# --- YooKassa (ЮКасса) — production ---
YOOKASSA_MERCHANT_ID=
YOOKASSA_API_KEY=
YOOKASSA_WEBHOOK_SECRET=
YOOKASSA_RETURN_URL=
YOOKASSA_TEST_MODE=true

# Legacy aliases (backward compatibility)
YOOMONEY_SHOP_ID=
YOOMONEY_SECRET_KEY_1=
YOOMONEY_SECRET_KEY_2=

# --- Yandex Delivery OAuth ---
YANDEX_DELIVERY_CLIENT_ID=
YANDEX_DELIVERY_CLIENT_SECRET=
YANDEX_REDIRECT_URI=https://yourdomain.com/delivery/callback/

# --- Yandex Delivery from address ---
YANDEX_FROM_CITY=moscow
YANDEX_FROM_STREET=
YANDEX_FROM_HOUSE=
YANDEX_FROM_APT=

# --- Yandex Metrika ---
YANDEX_METRIKA_ID=
YANDEX_METRIKA_WEBVIEWER=0

# --- Yandex OAuth 2.0 (User Authentication) ---
# Получить в консоли разработчика: https://developer.tech.yandex.ru/
# Включить "OAuth API для аккаунта Яндекс"
# Redirect URI: http://localhost:8000/accounts/oauth/complete/yandex/
YANDEX_OAUTH_CLIENT_ID=
YANDEX_OAUTH_CLIENT_SECRET=
